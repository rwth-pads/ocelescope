%-------------------
% Likert Macro
%-------------------

% Required for colors and resizing
\RequirePackage{xcolor}
\RequirePackage{graphicx}

% Global Likert settings (change once, affects all bars)
\newcommand{\likertheight}{8pt}   % bar height
\newcommand{\likertunit}{3}       % mm per percentage point
\newcommand{\likertwidth}{0.6}    % fraction of \textwidth

%------------------------------------------------
% 5-point Likert bar
% Arguments:
% #1 (optional) width factor (default = \likertwidth)
% #2 Agree
% #3 Strongly Agree
% #4 Neutral
% #5 Disagree
% #6 Strongly Disagree
%------------------------------------------------
\newcommand{\likertbar}[6][\likertwidth]{%
	\begin{tabular}{r c l}
		\resizebox{#1\textwidth}{\likertheight}{%
			\color{yellow}\rule{\the\numexpr#5*\likertunit\relax mm}{\likertheight}%
			\color{orange}\rule{\the\numexpr#6*\likertunit\relax mm}{\likertheight}%
			\color{lightgray}\rule{\the\numexpr#4*\likertunit\relax mm}{\likertheight}%
			\color{cyan}\rule{\the\numexpr#2*\likertunit\relax mm}{\likertheight}%
			\color{blue}\rule{\the\numexpr#3*\likertunit\relax mm}{\likertheight}%
		} &
	\end{tabular}%
}

%------------------------------------------------
% 7-point Likert bar
% Arguments:
% #1 (optional) width factor (default = \likertwidth)
% #2 Strongly Agree
% #3 Agree
% #4 Slightly Agree
% #5 Neutral
% #6 Slightly Disagree
% #7 Disagree
% #8 Strongly Disagree
%------------------------------------------------
\newcommand{\likertscaleSeven}[8][\likertwidth]{%
	\begin{tabular}{r c l}
		\resizebox{#1\textwidth}{\likertheight}{%
			\color{red}\rule{\the\numexpr#2*\likertunit\relax mm}{\likertheight}%
			\color{orange}\rule{\the\numexpr#3*\likertunit\relax mm}{\likertheight}%
			\color{yellow}\rule{\the\numexpr#4*\likertunit\relax mm}{\likertheight}%
			\color{lightgray}\rule{\the\numexpr#5*\likertunit\relax mm}{\likertheight}%
			\color{cyan!60}\rule{\the\numexpr#6*\likertunit\relax mm}{\likertheight}%
			\color{cyan}\rule{\the\numexpr#7*\likertunit\relax mm}{\likertheight}%
			\color{blue}\rule{\the\numexpr#8*\likertunit\relax mm}{\likertheight}%
		}
	\end{tabular}%
}
