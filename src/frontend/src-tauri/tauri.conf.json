{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ocelescope",
  "version": "0.1.0",
  "identifier": "com.ocelescope.dev",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI_BUILD=true npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ocelescope",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["bin/api/main"],
    "resources": ["../../../data", "../../backend/modules"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
